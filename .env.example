# FastAPI SOS service connection. This key stays in the Node server environment;
# it is never sent to or embedded in the browser.
SOS_SERVICE_URL=http://127.0.0.1:8001
SOS_SERVICE_API_KEY=

# Optional local-only KAALI DeepDefend FastAPI service for deepfake analysis.
DEEPFAKE_SERVICE_URL=http://127.0.0.1:8000

# Hash Shield FastAPI connection. Keep this service-to-service key private.
HASH_SHIELD_SERVICE_URL=http://127.0.0.1:8002
HASH_SHIELD_API_KEY=kaali-secret-key-12345

# Kaali binds to localhost by default. Set HOST only behind a protected HTTPS
# reverse proxy; this prototype does not include user accounts or login.
HOST=127.0.0.1
PORT=4173
