{
  "openapi": "3.1.0",
  "info": {
    "title": "Hash Shield Microservice \u2014 Project KAALI",
    "description": "Zero-knowledge privacy-preserving evidence collection, perceptual hashing, reverse web discovery, host RDAP lookup, and statutory 24-hour takedown engine for Project KAALI.",
    "version": "1.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Liveness probe returning service operational status.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/scan": {
      "post": {
        "tags": [
          "Discovery & Scanning"
        ],
        "summary": "Scan Image",
        "description": "Step 1: Upload original photo or public image URL \u2192 compute in-memory perceptual hashes \u2192 run web discovery.\nHARD RULES:\n1. Consent is required.\n2. If is_minor=True: Immediately halt and provide statutory child protection links (1098 / cybercrime.gov.in).\n3. If intimate=True: Do NOT scan third-party web engines. Return StopNCII instructions and allow manual URLs.\n4. If intimate=False: Run discovery provider, safely verify up to 20 candidates, and rank them.\n5. Image bytes are never stored on disk.",
        "operationId": "scan_image_v1_scan_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_image_v1_scan_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/hash": {
      "post": {
        "tags": [
          "Hashing"
        ],
        "summary": "Hash Image",
        "description": "Process an uploaded image entirely in memory.\nInspects magic bytes, computes pHash, dHash, SHA-256 and dimensions, then discards image bytes.\nNever stores image bytes on disk.",
        "operationId": "hash_image_v1_hash_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_hash_image_v1_hash_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/vault": {
      "post": {
        "tags": [
          "Vault"
        ],
        "summary": "Register Vault Hash",
        "description": "Register an authentic reference photo's perceptual fingerprints in a victim's private vault.\nStores only hashes, timestamp, and optional user label.",
