            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/match": {
      "post": {
        "tags": [
          "Matching"
        ],
        "summary": "Match Hash",
        "description": "Compare a suspect image (or provided hash) against all registered hashes in the user's vault.\nStrictly compares hashes from the same algorithm using Hamming distance.\nThreshold default: 10 bits.",
        "operationId": "match_hash_v1_match_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_match_hash_v1_match_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/cases": {
      "post": {
        "tags": [
          "Cases"
        ],
        "summary": "Create Case",
        "description": "Initialize an evidence recovery and takedown case.\nAccepts either:\n1. Legacy CaseCreateRequest ({user_id, urls[], evidence_hashes[], notes, is_minor})\n2. CaseCreateFromCandidatesRequest ({user_id, original_id, candidate_ids[], manual_urls[], notes, is_minor})\nStrict under-18 safety check: Immediately rejects if minor involvement is flagged.",
        "operationId": "create_case_v1_cases_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetailResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/cases/{case_id}/lookup": {
      "post": {
        "tags": [
          "Cases"
        ],
        "summary": "Lookup Case Hosts",
        "description": "Performs SSRF-safe RDAP and DNS lookup for each URL in the case.\nIdentifies domain registrar, hosting provider, and abuse desk contact emails.\nIf behind Cloudflare, returns its abuse form link (https://abuse.cloudflare.com).",
        "operationId": "lookup_case_hosts_v1_cases__case_id__lookup_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
