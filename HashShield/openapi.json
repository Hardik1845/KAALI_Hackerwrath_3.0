    "/v1/cases/{case_id}/check": {
      "post": {
        "tags": [
          "Cases"
        ],
        "summary": "Check Case Removal Status",
        "description": "Probes each URL in the case using non-destructive HEAD/GET requests with discarded bodies.\nDetects HTTP 404/410 (likely removed) vs HTTP 200/403 (inconclusive).\nNever trusts alone; user must verify before closure.",
        "operationId": "check_case_removal_status_v1_cases__case_id__check_post",
        "security": [
          {
            "APIKeyHeader": []
