API_KEY=kaali-secret-key-12345
HASH_THRESHOLD=10
SLA_HOURS=24
UPLOAD_MAX_MB=10
RATE_LIMIT_DEFAULT=60/minute
ENVIRONMENT=development
LOG_LEVEL=INFO

# Select serpapi_lens or google_vision for real reverse-image web discovery.
# Use mock only for local demo and automated checks; mock results are synthetic.
DISCOVER_PROVIDER=serpapi_lens
DISCOVER_DAILY_LIMIT=50
FETCH_CANDIDATE_IMAGES=true
MAX_CANDIDATES_TO_VERIFY=20
ENABLE_SSCD=false

# SerpApi Google Lens (SerpApi account/API key required)
SERPAPI_API_KEY=

# Or use Google Cloud Vision Web Detection (service account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=
